!examples/overrides.example.cfg
!examples/tech_unlocks.example.cfg
!examples/projectiles.example.cfg
/projectiles.cfg
/overrides.cfg
/tech_unlocks.cfg
*.bak
backups/
UCONFIG/
editor-backup-*/
.kknd2-*.tmp
.limits-*.tmp
.overrides-*.tmp
.unlocks-*.tmp
.projectiles-*.tmp
*.log

# Python caches, environments, packaging, and test artifacts.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Local IDE/OS files and game binaries (not distributed by this project).
.idea/
.vscode/
.env
.env.*
Thumbs.db
Desktop.ini
.DS_Store
*.exe
*.dll

